# Firebase — auth and Firestore only (both free on the Spark plan).
# These are compiled into the client bundle by design; Firebase keys are public
# identifiers, and access is controlled by Firestore rules, not by hiding them.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=

# Server side only — read by the functions in /api, never sent to the browser.
# FIREBASE_PROJECT_ID is the same value as above and is what the ID token is
# verified against.
FIREBASE_PROJECT_ID=
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=files
